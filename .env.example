# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- OpenAI (agent brain) ---------------------------------------------------
OPENAI_API_KEY=
# Optional. Leave empty to use the Agents SDK default model.
OPENAI_MODEL=

# --- Telegram ---------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids allowed to talk to the bot. Everyone else is ignored.
# Send /id to the bot to learn yours (it answers /id even when you are not allow-listed).
ALLOWED_CHAT_IDS=
# Chat that receives the scheduled morning digest (optional).
DIGEST_CHAT_ID=
DIGEST_CRON=0 9 * * *
DIGEST_TZ=Asia/Tashkent

# --- Active app -------------------------------------------------------------
# Name of the default catalog file in ./catalog (without .json)
DEFAULT_APP=plusfit

# --- AppMetrica -------------------------------------------------------------
# OAuth token with BOTH scopes: appmetrica:read and appmetrica:write
# (write is only needed for /instrument, which creates an AppMetrica application).
# https://appmetrica.yandex.com/docs/en/mobile-api/intro/authorization
APPMETRICA_OAUTH_TOKEN=
# Numeric application id (AppMetrica → Settings → Application ID)
APPMETRICA_APP_ID=
APPMETRICA_HOST=https://api.appmetrica.yandex.com

# --- Google: GA4 Data API + Firebase Remote Config --------------------------
# Path to a service-account JSON. The service account must be:
#   - Viewer on the GA4 property (GA4 Admin → Property access management)
#   - able to read Remote Config (roles/firebaseremoteconfig.viewer, or .admin to apply changes)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json
# Numeric GA4 property id (Firebase console → Project settings → Integrations → Google Analytics)
GA4_PROPERTY_ID=
FIREBASE_PROJECT_ID=

# --- RevenueCat -------------------------------------------------------------
# v2 secret API key (sk_...) and project id (proj...)
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=

# --- /instrument orchestration (optional) -----------------------------------
# Which headless coding agent runs the skill: "claude" or "codex"
INSTRUMENT_AGENT=claude
INSTRUMENT_MAX_TURNS=80
